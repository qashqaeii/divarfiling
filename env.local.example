# کپی روی ویندوز: cp env.local.example .env
# فقط توسعه لوکال — بدون secretهای Production

SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets-token-urlsafe-64
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TWITTER_SITE=

# PostgreSQL — کپی restore شده روی همین PC (هرگز IP سرور)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=divarfiling_local
DATABASE_USER=divarfiling_local
DATABASE_PASSWORD=change-me-local-db-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=0

# پرداخت — غیرفعال در لوکال (خالی = بدون درگاه واقعی)
ZIBAL_MERCHANT_ID=
ZIBAL_CALLBACK_URL=http://127.0.0.1:8000/payment/callback/

# لایسنس — کلیدهای جدا از Production (با dump واقعی برای bypass از LICENSE_ALLOW_LOCAL_DEV استفاده کنید)
LICENSE_SECRET_KEY=change-me-local-license-secret-min-32-chars
LICENSE_BOT_API_KEY=change-me-local-bot-api-key-min-32-chars
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_RATE_LIMIT_ACTIVATE=5
LICENSE_RATE_LIMIT_VALIDATE=60
LICENSE_RATE_LIMIT_DEACTIVATE=10
LICENSE_RATE_LIMIT_WINDOW=300
LICENSE_ALLOW_LOCAL_DEV=True
WORKSPACE_LICENSE_STAFF_BYPASS=False

# کش — locmem (بدون Redis)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# SMS / ایمیل — بدون ارسال واقعی
SMS_ENABLED=False
SMS_PROVIDER=console
FARAZSMS_API_KEY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=dev-local@localhost

# AI / acquisition / ابزار خارجی
AI_ENABLED=False
ARVAN_AI_ENABLED=False
ACQUISITION_AUTOMATION_ENABLED=False
PHONE_DETECTOR_DIR=

# ویجت‌ها و سرویس‌های عمومی
GOFTINO_WIDGET_ID=
PUBLIC_ASSISTANT_ENABLED=false
