# Django Settings — copy to .env on server
# cp .env.example .env   OR   cp env_template.txt .env

SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=divarfiling.ir,www.divarfiling.ir,212.80.29.56
SITE_URL=https://divarfiling.ir
# Twitter/X handle without @ — leave empty to omit twitter:site meta
TWITTER_SITE=
CSRF_TRUSTED_ORIGINS=https://divarfiling.ir,https://www.divarfiling.ir

# Goftino live chat — only loaded on public pages (base.html), not workspace
GOFTINO_WIDGET_ID=


# PostgreSQL (production)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=divarfilingDb
DATABASE_USER=divarfilingAdmin
DATABASE_PASSWORD=your-database-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=600

# Zibal Payment Gateway
ZIBAL_MERCHANT_ID=zibal
ZIBAL_CALLBACK_URL=https://divarfiling.ir/payment/callback/

# License Settings
LICENSE_SECRET_KEY=change-me-min-32-chars-random-string
LICENSE_BOT_API_KEY=change-me-min-32-chars-shared-with-desktop-app
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_RATE_LIMIT_ACTIVATE=5
LICENSE_RATE_LIMIT_VALIDATE=60
LICENSE_RATE_LIMIT_DEACTIVATE=10
LICENSE_RATE_LIMIT_WINDOW=300
LICENSE_ALLOW_LOCAL_DEV=False
WORKSPACE_LICENSE_STAFF_BYPASS=False

# AI Workspace — فاز صفر (Gemini primary + OpenRouter backup)
AI_ENABLED=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=10
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# خالی = مدل‌های :free از API هر ۲۴h
OPENROUTER_FREE_MODELS=
OPENROUTER_TIMEOUT_SECONDS=8
AI_GLOBAL_DAILY_CAP=350
AI_DAILY_TOKEN_LIMIT=30000

# CARTO raster basemaps (Map Pro / listing maps) — https://carto.com/basemaps/apikey
CARTO_BASEMAP_API_KEY=

# Cache (Redis — rate limit across gunicorn workers)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/1

# SMS / FarazSMS (IranPayamak) — https://docs.iranpayamak.com/
# console = لاگ در ترمینال بدون ارسال واقعی | faraz = پنل واقعی
SMS_ENABLED=True
SMS_PROVIDER=console
FARAZSMS_API_KEY=
# خط اختصاصی — بازاریابی، سیستمی، تمدید لایسنس
FARAZSMS_LINE_NUMBER=9982008148
# خط OTP — ورود، ثبت‌نام، تأیید موبایل (توصیه فراز: 90008361)
FARAZSMS_OTP_LINE_NUMBER=90008361
FARAZSMS_BASE_URL=https://api.iranpayamak.com
FARAZSMS_TIMEOUT=15
# شناسه دفترچه «کاربران» در پنل فراز اس‌ام‌اس
FARAZSMS_PHONEBOOK_USERS_ID=119558
FARAZSMS_OTP_ATTR=code
# یک الگوی مشترک OTP (پیشنهادی) — login، register و verify_phone
FARAZSMS_PATTERN_OTP=nIZehXxlu6
FARAZSMS_PATTERN_LOGIN=
FARAZSMS_PATTERN_REGISTER=
FARAZSMS_PATTERN_VERIFY_PHONE=
FARAZSMS_PATTERN_LICENSE_RENEWAL=
FARAZSMS_PATTERN_SYSTEM=
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_PEPPER=
OTP_DEBUG_RETURN_CODE=False

# Filing retention — temporary extracted listings (days)
FILING_LISTING_RETENTION_DAYS=31

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.divarfiling.ir
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@divarfiling.ir
EMAIL_HOST_PASSWORD=your-smtp-password-here
DEFAULT_FROM_EMAIL=noreply@divarfiling.ir

# Acquisition automation (phone-detector → Lead Acquisition Center)
ACQUISITION_AUTOMATION_ENABLED=True

# Filing listing retention (days) — stale extracted ads removed from temporary filing
FILING_LISTING_RETENTION_DAYS=31
ACQUISITION_COOLDOWN_HOURS=4
ACQUISITION_WORKER_POLL_SECONDS=30
# Absolute path to phone-detector checkout on server (NOT in divarfiling git repo)
PHONE_DETECTOR_DIR=/root/phone-detector
