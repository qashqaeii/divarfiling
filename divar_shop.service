[Unit]
Description=Gunicorn instance to serve Divar Shop Django application
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/Django
EnvironmentFile=/root/Django/.env
Environment="PATH=/root/Django/venv/bin"
ExecStart=/root/Django/venv/bin/gunicorn \
    --config /root/Django/gunicorn_config.py \
    divar_shop.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

